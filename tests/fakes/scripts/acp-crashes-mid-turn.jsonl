{"op":"on","method":"session/prompt","then":[{"op":"send","msg":{"jsonrpc":"2.0","method":"session/update","params":{"sessionId":"s1","update":{"sessionUpdate":"agent_message_chunk","content":{"type":"text","text":"half"}}}}},{"op":"wait","ms":30},{"op":"crash","code":3}]}
