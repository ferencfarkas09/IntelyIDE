{
  "format": 1,
  "about": "Cross-language vectors for paths::canonical_lossy (Rust) and canonicalLossy (sidecar/src/fsquery.ts). Build `tree` under an empty temp directory R (dirs, then files, then symlinks; `${ROOT}` in a link target is R itself). Each case: canonical(R + '/' + input) must equal realpath(R) + ('/' + expected), or realpath(R) alone when expected is empty. Inputs keep their spelling (trailing slash, ..). A case with `expectedOneOf` instead of `expected` accepts any listed value (a two-link loop ends on whichever name the 40th hop lands on, and that depends on how many symlinks the temp path itself has, e.g. /var -> /private/var).",
  "tree": [
    { "path": "a", "type": "dir" },
    { "path": "a/b", "type": "dir" },
    { "path": "a/b/c.txt", "type": "file" },
    { "path": "a/f.txt", "type": "file" },
    { "path": "ld", "type": "symlink", "target": "a/b" },
    { "path": "chain1", "type": "symlink", "target": "chain2" },
    { "path": "chain2", "type": "symlink", "target": "ld" },
    { "path": "dangling", "type": "symlink", "target": "missing/target" },
    { "path": "loopa", "type": "symlink", "target": "loopb" },
    { "path": "loopb", "type": "symlink", "target": "loopa" },
    { "path": "self", "type": "symlink", "target": "self" },
    { "path": "abslink", "type": "symlink", "target": "${ROOT}/a/b" },
    { "path": "dd", "type": "symlink", "target": "a/b/.." },
    { "path": "a/b/uplink", "type": "symlink", "target": "../.." }
  ],
  "cases": [
    { "name": "plain existing path", "input": "a/b/c.txt", "expected": "a/b/c.txt" },
    { "name": "dot components", "input": "./a/./b", "expected": "a/b" },
    { "name": "double slashes", "input": "a//b///c.txt", "expected": "a/b/c.txt" },
    { "name": ".. collapses", "input": "a/b/../f.txt", "expected": "a/f.txt" },
    { "name": ".. collapses over a missing name", "input": "a/nope/../f.txt", "expected": "a/f.txt" },
    { "name": "symlink to a directory", "input": "ld", "expected": "a/b" },
    { "name": "through a symlink to a directory", "input": "ld/c.txt", "expected": "a/b/c.txt" },
    { "name": "symlink chain", "input": "chain1", "expected": "a/b" },
    { "name": "symlink chain, then a file", "input": "chain1/c.txt", "expected": "a/b/c.txt" },
    { "name": "absolute symlink target", "input": "abslink/c.txt", "expected": "a/b/c.txt" },
    { "name": "symlink whose target ends in ..", "input": "dd", "expected": "a" },
    { "name": "dangling symlink", "input": "dangling", "expected": "missing/target" },
    { "name": "below a dangling symlink", "input": "dangling/x/y", "expected": "missing/target/x/y" },
    { "name": "symlink loop of two (gives up after 40 links, keeps the link; which end depends on how many links the temp path itself contains)", "input": "loopa", "expectedOneOf": ["loopa", "loopb"] },
    { "name": "symlink loop, other end", "input": "loopb", "expectedOneOf": ["loopa", "loopb"] },
    { "name": "symlink to itself", "input": "self", "expected": "self" },
    { "name": "below a symlink loop", "input": "loopa/x", "expectedOneOf": ["loopa/x", "loopb/x"] },
    { "name": "nonexistent tail", "input": "a/nope/x/y", "expected": "a/nope/x/y" },
    { "name": "nonexistent top", "input": "zz/yy", "expected": "zz/yy" },
    { "name": "trailing slash", "input": "a/b/", "expected": "a/b" },
    { "name": "trailing slash on a symlink", "input": "ld/", "expected": "a/b" },
    { "name": ".. after a symlink goes up from the REAL directory", "input": "ld/../f.txt", "expected": "a/f.txt" },
    { "name": ".. after a chain of symlinks", "input": "chain1/../f.txt", "expected": "a/f.txt" },
    { "name": "symlink pointing back up", "input": "a/b/uplink/a/f.txt", "expected": "a/f.txt" },
    { "name": "the root itself", "input": "", "expected": "" },
    { "name": "the root spelled with a dot", "input": ".", "expected": "" }
  ]
}
