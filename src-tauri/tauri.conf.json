{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IntelyIDE",
  "version": "1.6.0",
  "identifier": "com.intelyhome.intelyide",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm --filter @intely/ui dev",
    "beforeBuildCommand": "pnpm --filter @intely/sidecar build && pnpm --filter @intely/ui build && pnpm -w run build:relay-kit"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "IntelyIDE",
        "width": 1400,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "transparent": false,
        "backgroundColor": "#131417",
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; frame-src http://127.0.0.1:* http://localhost:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "copyright": "Copyright (c) 2026 Ferenc Farkas (IntelyHome) and IntelyIDE contributors",
    "license": "GPL-3.0-or-later",
    "licenseFile": "../LICENSE",
    "resources": {
      "../LICENSE": "legal/LICENSE",
      "../sidecar/dist/index.js": "sidecar/index.js",
      "../sidecar/dist/sdk-install.js": "sidecar/sdk-install.js",
      "resources/sidecar-package.json": "sidecar/package.json",
      "../sidecar/sdk-pin/package.json": "sdk-pin/package.json",
      "../sidecar/sdk-pin/package-lock.json": "sdk-pin/package-lock.json",
      "../sidecar/sdk-pin/tree.sha256": "sdk-pin/tree.sha256",
      "../sidecar/sdk-pin/hash-tree.mjs": "sdk-pin/hash-tree.mjs",
      "../remote-relay/src": "relay-kit/remote-relay/src",
      "../remote-relay/package.json": "relay-kit/remote-relay/package.json",
      "../remote-relay/pnpm-lock.yaml": "relay-kit/remote-relay/pnpm-lock.yaml",
      "../remote-relay/pnpm-workspace.yaml": "relay-kit/remote-relay/pnpm-workspace.yaml",
      "../remote-relay/wrangler.jsonc": "relay-kit/remote-relay/wrangler.jsonc",
      "../remote-web/package.json": "relay-kit/remote-web/package.json",
      "../remote-web/dist": "relay-kit/remote-web/dist"
    },
    "category": "DeveloperTool",
    "shortDescription": "A desktop Git client for several repositories at once, with coding agents that can edit but never commit or push.",
    "macOS": { "minimumSystemVersion": "13.5" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
