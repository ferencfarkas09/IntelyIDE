{
  "allKinds": [
    "session.started",
    "user.message",
    "text.delta",
    "text.done",
    "thinking.delta",
    "tool.start",
    "tool.update",
    "tool.result",
    "permission.request",
    "permission.resolved",
    "question.request",
    "plan",
    "note",
    "usage",
    "status",
    "error",
    "turn.end",
    "session.info"
  ],
  "batchMaxEvents": 64,
  "batchMaxMs": 33,
  "bypassKeeps": [
    "git",
    "gitTricks",
    "protectedPaths",
    "persistence",
    "secrets",
    "wrangler",
    "ideState",
    "procEnv",
    "isolation",
    "catastrophic"
  ],
  "cancelSoftMs": 5000,
  "cancelTermMs": 3000,
  "confirm": {
    "allOfKind": "*",
    "cliPromptTool": "intely:cli-prompt",
    "maxAllowEntries": 100,
    "maxCliReason": 300,
    "tierOne": [
      "read.never-read",
      "fs.protected",
      "fs.protected-arg",
      "fs.outside-jail",
      "exec.raw-text",
      "exec.too-long",
      "exec.secret-sink",
      "exec.catastrophic",
      "exec.proc-env",
      "exec.system-secrets",
      "shim.token",
      "hooks.install",
      "alias.git-write",
      "remote.git-write",
      "inline.git-write",
      "script.git-write",
      "script.protected-path",
      "pm.publish",
      "git.intely-refs",
      "git.binary-copy",
      "git.exec-option",
      "git.xargs",
      "git.credential",
      "git.reset-hard",
      "git.lfs-push",
      "git.stash",
      "git.branch",
      "git.remote",
      "git.fetch-local",
      "git.fetch-refspec",
      "git.reflog",
      "git.symbolic-ref",
      "git.config",
      "git.add-xargs",
      "git.add-all",
      "git.add-pathspec-file",
      "git.add-glob",
      "git.add-magic",
      "git.add-root",
      "env.git-override",
      "env.loader-override",
      "env.path-override",
      "mcp.args-unjudgeable",
      "mcp.protected-arg",
      "delegate.isolation",
      "workflow.isolation",
      "wrangler.api",
      "wrangler.binary-copy",
      "wrangler.credentials",
      "wrangler.env",
      "wrangler.exec",
      "wrangler.inline",
      "wrangler.node-entry",
      "wrangler.pm-exec",
      "wrangler.remote",
      "wrangler.script"
    ],
    "tierTwo": [
      {
        "rule": "read.never-read",
        "variant": "a secret-looking file inside a folder of the run"
      },
      {
        "rule": "fs.protected",
        "variant": "a `.env` file inside a folder of the run"
      },
      {
        "rule": "fs.protected-arg",
        "variant": "a `.env` file inside a folder of the run"
      },
      {
        "rule": "script.protected-path",
        "variant": "a `.env` file inside a folder of the run, named in a script or inline code"
      },
      {
        "rule": "cli.prompt-denied",
        "variant": "a prompt of the Claude CLI that Automatic and Bypass cannot answer"
      }
    ]
  },
  "heartbeatMs": 2000,
  "leaseTtlMs": 15000,
  "policyReplyTimeoutMs": 2000,
  "protocolVersion": 1,
