[
  {
    "id": "github",
    "title": "GitHub",
    "icon": "GitBranch",
    "category": "code",
    "transport": "http",
    "url": "https://api.githubcopilot.com/mcp/readonly",
    "headers": [
      {
        "name": "Authorization",
        "secret": true
      }
